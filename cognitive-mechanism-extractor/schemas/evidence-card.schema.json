{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyrebird.local/schemas/evidence-card.schema.json",
  "title": "EvidenceCard",
  "description": "证据卡 — 把候选人原始叙述转成可引用的最小证据单元,作为机制卡的回指依据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "source_type",
    "stage",
    "incident_title",
    "context",
    "trigger_moment",
    "task_or_problem",
    "critical_cues",
    "action_taken",
    "outcome",
    "candidate_quote",
    "interviewer_inference",
    "relevance_tags",
    "confidence_extractor"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^E(-CE)?-[0-9]{3,}$",
      "description": "格式 E-001 为正向证据;E-CE-001 为反证(counterevidence)。"
    },
    "source_type": {
      "type": "string",
      "enum": ["resume", "interview", "followup", "counterevidence"],
      "description": "证据来源类型。"
    },
    "stage": {
      "type": "string",
      "enum": ["hypothesis", "deep-dive", "synthesis", "validation"],
      "description": "在哪个阶段产生的证据。"
    },
    "incident_title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80,
      "description": "事件短标题,候选人可识别。"
    },
    "context": {
      "type": "string",
      "minLength": 20,
      "description": "背景、约束、角色、时间。"
    },
    "trigger_moment": {
      "type": "string",
      "minLength": 10,
      "description": "触发判断的具体时刻 — '那一瞬间发生了什么'。"
    },
    "task_or_problem": {
      "type": "string",
      "description": "当时要解决的具体问题。"
    },
    "critical_cues": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "候选人在那一刻识别到的关键信号(可能是别人没看到的)。"
    },
    "considered_options": {
      "type": "array",
      "items": { "type": "string" },
      "description": "当时考虑过的备选方案(用于显示权衡)。"
    },
    "decision_rule": {
      "type": "string",
      "description": "当时默认采用的判断规则/经验法则。"
    },
    "action_taken": {
      "type": "string",
      "description": "实际采取的动作。"
    },
    "outcome": {
      "type": "string",
      "description": "结果。若候选人未量化,必须写'未量化'。"
    },
    "candidate_quote": {
      "type": "string",
      "description": "候选人的关键原话或紧凑转述,标记为直接引用。"
    },
    "interviewer_inference": {
      "type": "string",
      "description": "Skill 的解释/推断。明确与原话区分,不可混淆。"
    },
    "relevance_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "signal-reading",
          "problem-framing",
          "tradeoff",
          "coordination",
          "iteration",
          "reflection",
          "stakeholder",
          "risk-management",
          "boundary-setting",
          "abstraction",
          "naming",
          "other"
        ]
      },
      "minItems": 1,
      "description": "标签,用于跨事件聚类时的初筛。"
    },
    "confidence_self": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "候选人自评把握度(可选)。"
    },
    "confidence_extractor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Skill 给出的证据把握度,基于叙事具体性与可追溯性。"
    },
    "related_mechanism_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^M-[0-9]{3,}$" },
      "description": "这张证据卡支撑哪些机制草案。"
    },
    "sensitivity_note": {
      "type": "string",
      "description": "是否需要匿名化/删敏(如公司名、客户名)。"
    }
  }
}
